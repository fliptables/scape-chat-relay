# Wrangler authentication for `npx wrangler deploy` / `tail` / `whoami`.
# Copy to `.env` (gitignored) and fill in real values, then:
#
#   source .env && npx wrangler deploy
#
# Or stick the exports in your ~/.zshrc if you want them always loaded.

# API token from https://dash.cloudflare.com/profile/api-tokens
# (Use the "Edit Cloudflare Workers" template — gives wrangler the scopes
# it needs to deploy + provision Durable Objects.)
export CLOUDFLARE_API_TOKEN="your-token-here"

# Account ID. Find via:
#   1. https://dash.cloudflare.com → your account → URL bar shows /<id>/...
#   2. Or run `npx wrangler whoami` once and read the "Account ID" column.
# Required because account-scoped tokens can't hit /memberships for
# auto-discovery (Cloudflare error code 9106).
export CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
