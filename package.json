{
  "name": "scape-chat-relay",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end-encrypted chat-room relay for Scape (Cloudflare Worker + Durable Objects).",
  "scripts": {
    "deploy": "npm run check && wrangler deploy",
    "dev": "wrangler dev",
    "test": "npm run check && node scripts/check-guard-battery.mjs && vitest run",
    "check": "node scripts/check-invariants.mjs && node scripts/check-swift-contract.mjs",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
